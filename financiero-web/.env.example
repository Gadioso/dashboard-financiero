# Public application
NEXT_PUBLIC_APP_URL=https://virafi.com
APP_URL=https://virafi.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Private and scheduled endpoints
DASHBOARD_ACCESS_TOKEN=your-private-dashboard-access-token
DASHBOARD_PRIVATE_PROFILE_ID=optional-auth-user-uuid-for-private-mode
CRON_SECRET=replace-with-a-long-random-secret
HEALTHCHECK_SECRET=replace-with-a-different-long-random-secret
AUDIT_IP_HASH_SECRET=replace-with-a-long-random-secret

# Google Gemini: the single AI provider
GEMINI_API_KEY=your-google-generative-ai-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STRUCTURED_MODEL=gemini-2.5-flash-lite
GEMINI_FINANCIAL_AGENT_MODEL=gemini-2.5-flash
AI_INTENT_LLM_ENABLED=false

# Telegram (optional product channel)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_BOT_DISPLAY_NAME=Virafi
TELEGRAM_NOTIFY_CHAT_ID=your-telegram-chat-id-for-alerts

# WhatsApp Cloud API (disabled until both gates are approved)
WHATSAPP_CHANNEL_MODE=off
WHATSAPP_AI_POLICY_APPROVED=false
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token

# Stripe
STRIPE_SECRET_KEY=sk_test_or_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BETA_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
